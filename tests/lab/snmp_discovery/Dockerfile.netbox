# NetBox 4.7 with the Lifecycle plugin (netbox-refresh) from a NetBoxV2
# checkout, so the executor's software reports are stored and can be checked.
# compose.yaml passes the plugin directory as the "lifecycle" build context.
FROM netboxcommunity/netbox:v4.7.4-5.1.1
COPY --from=lifecycle netbox_refresh /opt/netbox-plugins/netbox-refresh/netbox_refresh
COPY --from=lifecycle netbox_refresh/static/netbox_refresh /opt/netbox/netbox/static/netbox_refresh
ENV PYTHONPATH=/opt/netbox-plugins/netbox-refresh
