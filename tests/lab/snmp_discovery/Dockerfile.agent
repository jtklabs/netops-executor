# Simulated SNMP fleet: one snmpd per lab walk, each on its own address.
# Build context is this directory (see compose.yaml).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends snmpd snmp python3 iproute2 \
 && rm -rf /var/lib/apt/lists/*
COPY emulator /emulator
COPY walks /walks
COPY agent.py /agent.py
CMD ["python3", "/agent.py"]
